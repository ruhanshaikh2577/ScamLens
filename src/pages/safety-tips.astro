---
import Layout from "../layouts/Layout.astro";
import SafetyTips from "../components/SafetyTips.astro";
import CTA from "../components/CTA.astro";

const title = "Safety Tips — 13 Rules That Stop Almost Every Scam | ScamLens";
const description = "A printable checklist of the rules that defeat most scams: OTP discipline, QR/UPI logic, urgency tells, verification habits, investment guarantees, loan-app traps and golden-hour reporting.";
---

<Layout title={title} description={description} ogType="article">
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6">
    <nav class="text-caption text-ink-subtle" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink">Home</a>
      <span class="mx-2">/</span>
      <span class="text-ink-muted">Safety tips</span>
    </nav>
    <header class="mt-6" data-reveal>
      <p class="eyebrow">Safety tips</p>
      <h1 class="display-section mt-4">The checklist that beats the tricks</h1>
      <p class="mt-4 text-body-lg leading-relaxed text-ink-muted">
        Scammers rotate stories weekly, but the mechanics barely change. These rules target
        the mechanics. Print them, share them in the family group — no attribution needed.
      </p>
    </header>
  </section>

  <SafetyTips />

  <section class="border-t border-hairline px-4 pb-8 sm:px-6">
    <div class="mx-auto max-w-3xl" data-reveal>
      <div class="card panel-top-edge flex flex-col items-center gap-5 px-6 py-12 text-center">
        <h2 class="headline max-w-md">Not sure about a specific message?</h2>
        <p class="max-w-md text-body leading-relaxed text-ink-muted">
          The checker quotes the exact words it flagged — so you learn the pattern while you verify.
        </p>
        <a href="/#checker" class="btn btn-primary px-6">Check it in 10 seconds</a>
      </div>
    </div>
  </section>

  <CTA />
</Layout>
