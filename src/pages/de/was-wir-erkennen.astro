---
import Layout from "../../layouts/Layout.astro";
import WhatWeDetect from "../../components/WhatWeDetect.astro";
import CTA from "../../components/CTA.astro";
import FaqSection from "../../components/FaqSection.astro";
import whatFaqsMap from "../../content/faqs/what-we-detect";
import QuizIsland from "../../components/QuizIsland.tsx";
import SimulatorIsland from "../../components/SimulatorIsland.tsx";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const title = t("seo.what.title");
const description = t("seo.what.description");
const whatFaqs = (whatFaqsMap as Record<string, typeof whatFaqsMap.en>)[lang] ?? whatFaqsMap.en;
---

<Layout title={title} description={description} ogType="article">
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6">
    <nav class="text-caption text-ink-subtle" aria-label={t("a11y.breadcrumb")}>
      <a href={translatePath("/")} class="hover:text-ink">{t("nav.breadcrumb.home")}</a>
      <span class="mx-2">/</span>
      <span class="text-ink-muted">{t("nav.what")}</span>
    </nav>
    <header class="mt-6" data-reveal>
      <p class="eyebrow">{t("what.eyebrow")}</p>
      <h1 class="display-section mt-4">{t("what.title")}</h1>
      <p class="mt-4 text-body-lg leading-relaxed text-ink-muted">
        {t("what.subtitle")}
      </p>
    </header>
  </section>

  <WhatWeDetect extended />

  <section class="border-t border-hairline px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-3xl space-y-8">
      <QuizIsland client:load lang={lang} />
      <SimulatorIsland client:load lang={lang} />
    </div>
  </section>

  <section class="border-t border-hairline px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-3xl" data-reveal>
      <h2 class="headline">{t("what.where.title")}</h2>
      <p class="mt-3 text-body leading-relaxed text-ink-muted">
        {t("what.where.body")}
      </p>
      <div class="mt-8 flex flex-col gap-2 sm:flex-row">
        <a href={translatePath("/scams")} class="btn btn-primary flex-1">{t("what.where.browse")}</a>
        <a href={`${translatePath("/")}#checker`} class="btn btn-secondary flex-1">{t("what.where.check")}</a>
      </div>
    </div>
  </section>

  <FaqSection faqs={whatFaqs} eyebrow="FAQ" title={lang==="es"?"Detectamos — Preguntas frecuentes": lang==="fr"?"Détection — FAQ": lang==="de"?"Erkennung — FAQ": lang==="pt-br"?"Detecção — Perguntas": lang==="it"?"Rilevamento — FAQ": lang==="ja"?"検出に関するFAQ": lang==="ko"?"탐지 FAQ": "What we detect — FAQ"} id="faq-what" />

  <CTA />
</Layout>
