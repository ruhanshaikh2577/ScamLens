---
import PreviewShell from "../../layouts/PreviewShell.astro";
import CheckerIsland from "../../components/checker/CheckerIsland";

export function getStaticPaths() {
  return [
    { params: { variant: "opt1" } },
    { params: { variant: "opt2" } },
    { params: { variant: "opt3" } },
    { params: { variant: "recommended" } },
  ];
}
const { variant } = Astro.params as { variant: string };
type V = "opt1" | "opt2" | "opt3" | "recommended";
const v = (variant as V) || "opt1";

// content — same as live site, English source
const hero = {
  opt1: { eyebrow: "CHROME · LAMP · GLASS FRACTAL", title: "Spot every", title2: "scam.", sub: "Lamp-lit chrome meets obsidian. Paste a message, link or screenshot — get quoted evidence, not a mystery score.", cta: "Check now — free" },
  opt2: { eyebrow: "SHADER HERO · WARP STRIPES · BEAMS", title: "Verify in", title2: "seconds.", sub: "Beams collide, warp stripes drift. Cyber-cinema for a trust tool — still on-device, still explainable.", cta: "Scan a message" },
  opt3: { eyebrow: "AETHER RIBBON · FLUID FIELD · IMAGE FAN", title: "Your lens", title2: "for the noise.", sub: "Editorial paper, ribbon mesh, fluid contours. For the reader who learns by seeing patterns, not scores.", cta: "Try the checker" },
  recommended: { eyebrow: "RECOMMENDED · SOVEREIGN SIGNAL", title: "Check the", title2: "message.", sub: "Keep the money. The tuned vault — dot grid + warps 8% + shine halo, paper clarity, trust-blue signal. Light, fast, AA.", cta: "Check now — takes 10s" },
}[v];

const stats = [
  { v: "880k+", l: "complaints filed with FBI IC3 in 2023" },
  { v: "$12.5B+", l: "reported losses to cyber fraud" },
  { v: "3.4B+", l: "phishing emails sent daily" },
];
const steps = [
  { n: "01", t: "Pick your input", d: "Message, screenshot or link — one checker handles all three. Drop anything." },
  { n: "02", t: "Redacted first", d: "OTPs, card numbers, mobiles masked locally before any pattern scan." },
  { n: "03", t: "Pattern scan", d: "Urgency, payment asks, impersonation, shorteners, punycode, APK tricks — quoted evidence." },
  { n: "04", t: "Reasons, not score", d: "Every flag shows the exact quote + why it matters + safe next step. You stay the judge." },
];
const detectCards = [
  { t: "Messages & calls", d: "OTP theft, urgency, bank / courier impersonation in SMS, forwards, calls." },
  { t: "Fake links", d: "Shorteners, look-alike domains, punycode, raw IPs, @-tricks, APK downloads." },
  { t: "Screenshots & QR", d: "Edited payment proofs, fake success screens, scan-to-receive QR traps." },
  { t: "Toll & transit", d: "Unpaid toll / FASTag / E-ZPass clones harvesting cards via brand spoof." },
  { t: "Job offers", d: "Work-from-home with registration fees, like-and-earn task kits." },
  { t: "Authority fear", d: "Digital arrest, police / tax threats over video call or transfer demand." },
];
const safety = [
  "Never pay to receive money — prizes, refunds, parcels, jobs.",
  "No bank or wallet ever asks for OTP / PIN / CVV — on any channel.",
  "Urgency is the tell — today / 24h / final warning exist to stop thinking.",
  "Verify via official app, not the number in the message.",
  "Type URLs yourself; check the domain character by character.",
  "Screenshot ≠ proof — check your bank, not their image.",
];
---

<PreviewShell title={`${hero.title} ${hero.title2} — Preview ${v} | ScamLens`} description={hero.sub} variant={v}>
  <!-- top switcher -->
  <div style="position:sticky;top:0;z-index:40;backdrop-filter:blur(12px);background:color-mix(in srgb, var(--bg) 84%, transparent);border-bottom:1px solid var(--border)">
    <div style="max-width:1120px;margin:0 auto;padding:10px 16px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:12px">
      <span style="background:var(--ink);color:var(--bg);padding:5px 10px;border-radius:9999px;font-weight:700;letter-spacing:0.06em">PREVIEW · {v.toUpperCase()}</span>
      <span style="color:var(--subtle)" class="hide-sm">Full redesign — no old colors, fonts, radii — same content</span>
      <span style="margin-left:auto;display:flex;gap:6px;align-items:center">
        <a href="/preview" style="border:1px solid var(--border);background:var(--surface);color:var(--ink);padding:6px 12px;border-radius:9999px;font-weight:500">← Hub</a>
        <a href="/" style="border:1px solid var(--border);background:var(--surface);color:var(--subtle);padding:6px 12px;border-radius:9999px" class="hide-sm">Live site →</a>
      </span>
      <div style="display:flex;gap:6px;width:100%;margin-top:2px">
        <a href="/preview/opt1" style={`flex:1;text-align:center;padding:7px 8px;border-radius:9999px;font-weight:600;border:1px solid ${v==="opt1"?"var(--ink)":"var(--border)"};background:${v==="opt1"?"var(--ink)":"var(--surface)"};color:${v==="opt1"?"var(--bg)":"var(--subtle)"}`}>opt1 chrome</a>
        <a href="/preview/opt2" style={`flex:1;text-align:center;padding:7px 8px;border-radius:9999px;font-weight:600;border:1px solid ${v==="opt2"?"var(--ink)":"var(--border)"};background:${v==="opt2"?"var(--ink)":"var(--surface)"};color:${v==="opt2"?"var(--bg)":"var(--subtle)"}`}>opt2 nebula</a>
        <a href="/preview/opt3" style={`flex:1;text-align:center;padding:7px 8px;border-radius:9999px;font-weight:600;border:1px solid ${v==="opt3"?"var(--ink)":"var(--border)"};background:${v==="opt3"?"var(--ink)":"var(--surface)"};color:${v==="opt3"?"var(--bg)":"var(--subtle)"}`}>opt3 paper</a>
        <a href="/preview/recommended" style={`flex:1;text-align:center;padding:7px 8px;border-radius:9999px;font-weight:700;border:1px solid ${v==="recommended"?"var(--primary)":"var(--border)"};background:${v==="recommended"?"var(--primary)":"var(--surface)"};color:${v==="recommended"?"var(--primary-ink)":"var(--subtle)"}`}>★ rec</a>
      </div>
    </div>
  </div>

  <!-- NAV — new, not old navy+emerald -->
  <header style="max-width:1120px;margin:0 auto;padding:14px 16px;display:flex;align-items:center;gap:16px">
    <a href={`/preview/${v}`} style="display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-0.04em;font-family:var(--font-display);font-size:18px">
      <span style="width:28px;height:28px;border-radius:9px;background:var(--ink);color:var(--bg);display:grid;place-items:center;font-size:13px">◈</span>
      ScamLens <span style="font-weight:500;color:var(--subtle);font-family:var(--font-body);font-size:13px;letter-spacing:0">/ preview</span>
    </a>
    <nav style="display:none;gap:18px;margin-left:24px;font-size:14px;color:var(--muted)" class="nav-desktop">
      <a href="#how" style="hover:color:var(--ink)">How it works</a><a href="#detect">What we detect</a><a href="#example">Example</a><a href="#faq">FAQ</a>
    </nav>
    <span style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <span style="display:none;gap:6px;font-size:12px;color:var(--subtle)" class="hide-sm"><span style="width:7px;height:7px;border-radius:9999px;background:var(--accent)"></span> On-device</span>
      <a href="#checker" style="background:var(--primary);color:var(--primary-ink);padding:10px 18px;border-radius:9999px;font-weight:600;font-size:14px;box-shadow:var(--shadow)">Check now →</a>
    </span>
  </header>

  <!-- HERO — variant-specific 21st treatments, full-bleed -->
  {v==="opt1" && (
    <section style="position:relative;overflow:hidden;padding:36px 16px 28px">
      <div style="position:absolute;inset:0;z-index:-1;background:var(--bg)">
        <div style="position:absolute;inset:0;opacity:0.45;background-image:radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--border-strong) 60%, transparent) 1px, transparent 0);background-size:22px 22px;mask-image:radial-gradient(ellipse 90% 70% at 50% 0%, black 55%, transparent 90%)"></div>
        <div style="position:absolute;left:50%;top:-6%;width:880px;height:520px;transform:translateX(-50%);background:linear-gradient(to bottom, color-mix(in srgb, var(--accent) 18%, transparent), transparent);clip-path:polygon(38% 0,62% 0,78% 100%,22% 100%);filter:blur(0.5px)"></div>
        <div style="position:absolute;left:50%;top:0;width:680px;height:1px;transform:translateX(-50%);background:linear-gradient(to right, transparent, color-mix(in srgb, var(--accent) 55%, transparent), transparent)"></div>
        <div style="position:absolute;left:50%;top:0;width:320px;height:1px;transform:translateX(-50%);background:var(--accent);filter:blur(6px);opacity:0.5"></div>
        <div style="position:absolute;left:-60px;top:40px;width:420px;height:420px;border-radius:9999px;background:color-mix(in srgb, var(--accent) 14%, transparent);filter:blur(70px)"></div>
        <div style="position:absolute;right:-40px;top:80px;width:360px;height:360px;border-radius:9999px;background:var(--surface-2);filter:blur(70px);opacity:0.6"></div>
      </div>
      <div style="max-width:1120px;margin:0 auto;text-align:center">
        <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.14em;color:var(--accent);font-weight:600">{hero.eyebrow}</p>
        <h1 class="display" style="font-size:clamp(36px,7vw,64px);margin:14px auto 0;max-width:720px">{hero.title}<br/><span style="color:var(--subtle);font-weight:600">{hero.title2}</span></h1>
        <p style="margin:16px auto 0;max-width:560px;color:var(--muted);font-size:18px;line-height:1.5">{hero.sub}</p>
        <div style="margin-top:18px;display:flex;flex-wrap:wrap;gap:8px;justify-content:center;font-size:12px">
          <span style="border:1px solid var(--border);background:var(--surface);color:var(--muted);padding:6px 10px;border-radius:9999px">21st: <a href="https://21st.dev/@manuarora700/components/lamp" target="_blank" rel="noopener" style="text-decoration:underline;text-underline-offset:3px">Lamp</a> · <a href="https://21st.dev/@vgpu/components/glass-fractal" target="_blank" rel="noopener" style="text-decoration:underline;text-underline-offset:3px">Glass Fractal</a></span>
          <span style="border:1px solid var(--border);background:var(--surface);color:var(--muted);padding:6px 10px;border-radius:9999px">Financial hero stats →</span>
        </div>
      </div>
      <div style="max-width:720px;margin:28px auto 0;position:relative;padding:1.5px;border-radius:22px;background:linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 70%, transparent), transparent);background-size:200% 100%">
        <div style="background:var(--surface);border-radius:20px;padding:6px;box-shadow:var(--shadow);border:1px solid var(--border)">
          <CheckerIsland client:visible lang="en" />
        </div>
      </div>
      <p style="text-align:center;margin-top:8px;font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;color:var(--subtle)">DOT PATTERN · SHINE BORDER · LARGE NAME — CHROME OBSIDIAN</p>
      <div style="max-width:720px;margin:18px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;text-align:center">
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:14px"><p style="font-family:var(--font-display);font-size:22px;font-weight:700;letter-spacing:-0.03em">~2s</p><p style="font-size:12px;color:var(--subtle)">to verdict</p></div>
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:14px"><p style="font-family:var(--font-display);font-size:22px;font-weight:700;letter-spacing:-0.03em">100%</p><p style="font-size:12px;color:var(--subtle)">on-device</p></div>
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:14px"><p style="font-family:var(--font-display);font-size:22px;font-weight:700;letter-spacing:-0.03em">8</p><p style="font-size:12px;color:var(--subtle)">locales</p></div>
      </div>
    </section>
  )}
  {v==="opt2" && (
    <section style="position:relative;overflow:hidden;padding:36px 16px 28px">
      <div style="position:absolute;inset:0;z-index:-1;background:var(--bg)">
        <div style="position:absolute;inset:0;opacity:0.22;background:linear-gradient(100deg, transparent 40%, color-mix(in srgb, var(--primary) 18%, transparent) 50%, transparent 60%), linear-gradient(80deg, transparent 30%, color-mix(in srgb, var(--accent) 14%, transparent) 50%, transparent 70%)"></div>
        <div style="position:absolute;left:0;right:0;top:38%;height:1px;background:linear-gradient(to right, transparent, color-mix(in srgb, var(--primary) 60%, transparent), transparent)"></div>
        <div style="position:absolute;left:18%;top:36%;width:8px;height:8px;border-radius:9999px;background:var(--primary);box-shadow:0 0 20px var(--primary)"></div>
        <div style="position:absolute;right:18%;top:36%;width:8px;height:8px;border-radius:9999px;background:var(--accent);box-shadow:0 0 20px var(--accent)"></div>
        <div style="position:absolute;inset:0;opacity:0.06;background:repeating-linear-gradient(105deg, var(--primary) 0 1px, transparent 1px 14px)"></div>
        <div style="position:absolute;left:50%;bottom:-80px;width:900px;height:420px;transform:translateX(-50%);border-radius:9999px;background:radial-gradient(ellipse at center, color-mix(in srgb, var(--primary) 14%, transparent), transparent 70%);filter:blur(30px)"></div>
      </div>
      <div style="max-width:1120px;margin:0 auto;text-align:center">
        <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.14em;color:var(--primary);font-weight:600">{hero.eyebrow}</p>
        <h1 class="display" style="font-size:clamp(36px,7vw,64px);margin:14px auto 0;max-width:720px">{hero.title}<br/><span style="color:var(--subtle);font-weight:600">{hero.title2}</span></h1>
        <p style="margin:16px auto 0;max-width:560px;color:var(--muted);font-size:18px;line-height:1.5">{hero.sub}</p>
        <div style="margin-top:18px;display:flex;flex-wrap:wrap;gap:8px;justify-content:center;font-size:12px">
          <span style="border:1px solid var(--border);background:var(--surface);color:var(--muted);padding:6px 10px;border-radius:9999px">21st: Shader Hero · Warp Stripes</span>
          <span style="border:1px solid color-mix(in srgb, var(--primary) 30%, transparent);background:color-mix(in srgb, var(--primary) 10%, transparent);color:var(--primary);padding:6px 10px;border-radius:9999px">Live shader · 60fps</span>
        </div>
      </div>
      <div style="max-width:720px;margin:28px auto 0;position:relative;border-radius:20px;overflow:hidden;border:1px solid color-mix(in srgb, var(--primary) 20%, transparent);background:var(--surface);box-shadow:var(--shadow);padding:6px">
        <div style="position:absolute;inset:0;pointer-events:none;opacity:0.5;background:radial-gradient(400px 120px at 50% 0%, color-mix(in srgb, var(--primary) 12%, transparent), transparent 70%)"></div>
        <CheckerIsland client:visible lang="en" />
      </div>
      <p style="text-align:center;margin-top:8px;font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;color:var(--subtle)">BEAMS COLLISION · OCEANIC SHIMMER · NEXUS DOCS</p>
    </section>
  )}
  {v==="opt3" && (
    <section style="position:relative;overflow:hidden;padding:36px 16px 28px">
      <div style="position:absolute;inset:0;z-index:-1;background:var(--bg)">
        <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.16" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true">
          <path d="M-100 180 C 220 80, 480 320, 700 180 S 1000 420, 1300 220" fill="none" stroke="#8B5CF6" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M-100 260 C 280 140, 520 380, 740 240 S 1050 460, 1300 300" fill="none" stroke="#A78BFA" stroke-width="1" opacity="0.7"/>
          <path d="M-100 340 C 320 200, 560 440, 780 300 S 1100 500, 1300 380" fill="none" stroke="#C4B5FD" stroke-width="0.9" opacity="0.5"/>
        </svg>
        <div style="position:absolute;left:-40px;top:40px;width:360px;height:360px;border-radius:9999px;background:#8B5CF6;opacity:0.09;filter:blur(60px)"></div>
        <div style="position:absolute;right:-20px;top:20px;width:320px;height:320px;border-radius:9999px;background:#EC4899;opacity:0.08;filter:blur(60px)"></div>
      </div>
      <div style="max-width:1120px;margin:0 auto;text-align:center">
        <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.14em;color:var(--accent);font-weight:600">{hero.eyebrow}</p>
        <h1 class="display" style="font-size:clamp(36px,7vw,62px);margin:14px auto 0;max-width:720px">{hero.title} <em style="font-family:var(--font-display-2);font-style:italic;font-weight:400">{hero.title2}</em></h1>
        <p style="margin:16px auto 0;max-width:560px;color:var(--muted);font-size:18px;line-height:1.5">{hero.sub}</p>
        <div style="margin-top:18px;display:flex;flex-wrap:wrap;gap:8px;justify-content:center;font-size:12px">
          <span style="border:1px solid var(--border);background:var(--surface);color:var(--muted);padding:6px 10px;border-radius:9999px">21st: Aether Ribbon · Fluid Field</span>
          <span style="border:1px solid var(--border);background:var(--surface);color:var(--muted);padding:6px 10px;border-radius:9999px">Image Fan preview ↓</span>
        </div>
      </div>
      <div style="max-width:720px;margin:28px auto 0;border-radius:18px;border:1px solid var(--border);background:var(--surface);box-shadow:var(--shadow);padding:6px">
        <CheckerIsland client:visible lang="en" />
      </div>
      <div style="max-width:760px;margin:22px auto 0">
        <p style="text-align:center;font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;color:var(--subtle);margin-bottom:10px">CENTERED HERO WITH IMAGE FAN</p>
        <div style="display:flex;justify-content:center;gap:10px">
          <div style="width:160px;height:112px;transform:rotate(-3deg);border-radius:14px;border:1px solid var(--border);background:var(--surface-2);overflow:hidden"><div style="width:100%;height:100%;background:linear-gradient(135deg, #ddd6fe, #fbcfe8)"></div></div>
          <div style="width:160px;height:112px;transform:rotate(1deg) translateY(-8px);border-radius:14px;border:1px solid var(--border-strong);background:var(--surface);box-shadow:var(--shadow);display:grid;place-items:center;font-family:var(--font-mono);font-size:11px;color:var(--subtle)">Checker UI</div>
          <div style="width:160px;height:112px;transform:rotate(3deg);border-radius:14px;border:1px solid var(--border);background:var(--surface-2);overflow:hidden"><div style="width:100%;height:100%;background:linear-gradient(135deg, #a5f3fc, #ddd6fe)"></div></div>
        </div>
      </div>
    </section>
  )}
  {v==="recommended" && (
    <section style="position:relative;overflow:hidden;padding:36px 16px 28px">
      <div style="position:absolute;inset:0;z-index:-1;background:var(--bg)">
        <div style="position:absolute;inset:0;opacity:0.35;background-image:radial-gradient(circle at 1px 1px, #cbd5e1 1px, transparent 0);background-size:20px 20px;mask-image:radial-gradient(ellipse 90% 70% at 50% 0%, black 60%, transparent 92%)"></div>
        <div style="position:absolute;inset:0;background:radial-gradient(900px 420px at 50% 0%, transparent 60%, color-mix(in srgb, var(--bg) 70%, transparent) 100%)"></div>
        <div style="position:absolute;inset:0;opacity:0.04;background:repeating-linear-gradient(115deg, var(--primary) 0 1px, transparent 1px 12px)"></div>
        <div style="position:absolute;left:50%;top:-4%;width:880px;height:520px;transform:translateX(-50%);background:linear-gradient(to bottom, color-mix(in srgb, var(--primary) 7%, transparent), transparent);clip-path:polygon(41% 0,59% 0,73% 100%,27% 100%)"></div>
        <div style="position:absolute;left:50%;top:0;width:640px;height:1px;transform:translateX(-50%);background:linear-gradient(to right, transparent, var(--border-strong), transparent)"></div>
      </div>
      <div style="max-width:1120px;margin:0 auto;text-align:center">
        <p style="display:inline-flex;align-items:center;gap:8px;border:1px solid color-mix(in srgb, var(--primary) 18%, transparent);background:color-mix(in srgb, var(--primary) 7%, transparent);color:var(--primary);padding:5px 10px;border-radius:9999px;font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;font-weight:600"><span style="width:7px;height:7px;border-radius:9999px;background:var(--primary);display:inline-block"></span> RECOMMENDED · TUNED</p>
        <h1 class="display" style="font-size:clamp(38px,7vw,64px);margin:14px auto 0;max-width:720px">{hero.title}<br/><span style="color:var(--subtle);font-weight:600">{hero.title2}</span></h1>
        <p style="margin:16px auto 0;max-width:560px;color:var(--muted);font-size:18px;line-height:1.5">{hero.sub}</p>
        <div style="margin-top:18px;display:flex;flex-wrap:wrap;gap:8px;justify-content:center;font-size:12px">
          <span style="border:1px solid color-mix(in srgb, var(--primary) 22%, transparent);background:color-mix(in srgb, var(--primary) 8%, transparent);color:var(--primary);padding:6px 10px;border-radius:9999px;font-weight:600">21st: Lamp · Warp Stripes 8%</span>
          <span style="border:1px solid var(--border);background:var(--surface);color:var(--muted);padding:6px 10px;border-radius:9999px">Dot + Vignette · Shine halo</span>
          <span style="border:1px solid var(--border);background:var(--surface);color:var(--muted);padding:6px 10px;border-radius:9999px">Signal Trust — paper clarity</span>
        </div>
      </div>
      <div style="max-width:720px;margin:28px auto 0;position:relative;padding:1.4px;border-radius:20px;background:linear-gradient(90deg, transparent, color-mix(in srgb, var(--primary) 22%, transparent), transparent)">
        <div style="background:var(--surface);border-radius:19px;padding:6px;border:1px solid var(--border);box-shadow:var(--shadow)">
          <CheckerIsland client:visible lang="en" />
        </div>
      </div>
      <p style="text-align:center;margin-top:8px;font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;color:var(--subtle)">SHINE BORDER (hover) · DOT GRID · TRUST BLUE #2563EB</p>
      <div style="max-width:720px;margin:16px auto 0;display:flex;justify-content:center">
        <a href="#checker" style="background:var(--primary);color:var(--primary-ink);padding:11px 18px;border-radius:9999px;font-weight:600;font-size:14px;display:inline-flex;gap:8px;align-items:center;box-shadow:var(--shadow)">{hero.cta} <span style="opacity:0.8">→</span></a>
      </div>
