---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import AboutReportBox from "../components/AboutReportBox.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  title={t("seo.about.title")}
  description={t("seo.about.description")}
>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <p class="eyebrow">{t("about.eyebrow")}</p>
    <h1 class="display-section mt-4">{t("about.title")}</h1>
    <div class="mt-8 space-y-6 text-body-lg leading-relaxed text-ink-muted">
      <p>{t("about.p1")}</p>
      <p>{t("about.p2")}</p>
      <p>{t("about.p3")}</p>
      <AboutReportBox />
    </div>
    <a href={`${translatePath("/")}#checker`} class="btn btn-primary mt-10 px-6">{t("about.cta")}</a>
  </section>
</Layout>
