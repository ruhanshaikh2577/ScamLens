---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/Ticker.astro";
import StatsBand from "../components/StatsBand.astro";
import HowItWorks from "../components/HowItWorks.astro";
import WhatWeDetect from "../components/WhatWeDetect.astro";
import ExampleAnalysis from "../components/ExampleAnalysis.astro";
import ScamLibraryGrid from "../components/ScamLibraryGrid.astro";
import SafetyTips from "../components/SafetyTips.astro";
import FAQ from "../components/FAQ.astro";
import SEOContent from "../components/SEOContent.astro";
import CTA from "../components/CTA.astro";

const homepageTitle = "ScamLens — AI Scam Detector, Scam Checker & Fake Website Checker";
const homepageDescription = "ScamLens is an AI scam detector to verify website safety. Check fake websites, phishing links, malicious URLs and scam screenshots with real-time fraud detection.";
const homepageKeywords = "scam detector, scam checker, fake website checker, phishing link checker, verify website safety, how to check if a website is a scam";
const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ScamLens",
  alternateName: "ScamLens Scam Detector",
  applicationCategory: "SecurityApplication",
  operatingSystem: "Any",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
  description: homepageDescription,
  url: "https://scamlens.in/",
  image: "https://scamlens.in/og.png",
  author: { "@type": "Organization", name: "ScamLens", url: "https://scamlens.in" },
  featureList: [
    "AI scam detector",
    "scam checker",
    "fake website checker",
    "phishing link checker",
    "phishing URL detector",
    "malicious link detector",
    "link safety checker",
    "URL scam checker",
    "scam image detector",
    "fake screenshot detector",
    "real-time scam detection",
    "online fraud checker",
    "cyber scam detector",
    "fraud detection tool",
  ],
};
---

<Layout
  title={homepageTitle}
  description={homepageDescription}
  keywords={homepageKeywords}
  ogImage="https://scamlens.in/og.png"
  ogType="website"
  showAnchorAd={true}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <Hero />
  <Ticker />
  <StatsBand />
  <HowItWorks />
  <WhatWeDetect />
  <ExampleAnalysis />
  <ScamLibraryGrid limit={6} />
  <SafetyTips limit={6} />
  <FAQ />
  <SEOContent />
  <CTA />
</Layout>
