---
import Layout from "../../../layouts/Layout.astro";
import ScamLibraryGrid from "../../../components/ScamLibraryGrid.astro";
import FaqSection from "../../../components/FaqSection.astro";
import libFaqsMap from "../../../content/faqs/scamlibrary";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const libFaqs = (libFaqsMap as Record<string, typeof libFaqsMap.en>)[lang] ?? libFaqsMap.en;
---

<Layout
  title={t("seo.scams.title")}
  description={t("seo.scams.description")}
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div data-reveal>
      <p class="eyebrow">{t("footer.scams")}</p>
      <h1 class="display-section mt-4 max-w-2xl">{lang==="es"?"Cada patrón, explicado con pruebas": lang==="fr"?"Chaque schéma, expliqué avec des preuves": lang==="de"?"Jedes Muster, mit Beweisen erklärt": lang==="pt-br"?"Cada padrão, explicado com provas": lang==="it"?"Ogni schema, spiegato con prove": lang==="ja"?"すべてのパターンを証拠で解説": lang==="ko"?"모든 패턴을 증거로 설명": "Every pattern, explained with the evidence"}</h1>
      <p class="mt-4 max-w-xl text-body-lg leading-relaxed text-ink-muted">
        {t("seo.scams.description")}
      </p>
    </div>

    <ScamLibraryGrid heading={false} />

    <aside data-reveal class="mt-12 rounded-lg border border-hairline bg-surface-1 px-4 py-3 text-center" aria-label="Advertisement">
      <span class="text-xs uppercase tracking-widest text-ink-tertiary">Advertisement</span>
    </aside>

    <div data-reveal class="card panel-top-edge mt-16 flex flex-col items-center gap-5 px-6 py-12 text-center">
      <h2 class="headline max-w-md">{t("safety.cta.title")}</h2>
      <a href={`${translatePath("/")}#checker`} class="btn btn-primary px-6">{t("safety.cta.btn")}</a>
    </div>
  </section>

  <FaqSection faqs={libFaqs} eyebrow="FAQ" title={lang==="es"?"Biblioteca — Preguntas frecuentes": lang==="fr"?"Bibliothèque — FAQ": lang==="de"?"Bibliothek — FAQ": lang==="pt-br"?"Biblioteca — Perguntas": lang==="it"?"Biblioteca — FAQ": lang==="ja"?"ライブラリに関するFAQ": lang==="ko"?"라이브러리 FAQ": "Scam Library — FAQ"} id="faq-library" />
</Layout>
