---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("seo.terms.title")}
  description={t("seo.terms.description")}
>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <p class="eyebrow">{t("terms.eyebrow")}</p>
    <h1 class="display-section mt-4">{t("terms.title")}</h1>
    <div class="mt-8 space-y-6 text-body leading-relaxed text-ink-muted">
      <p>{t("terms.p1")}</p>
      <p>{t("terms.p2")}</p>
      <p>{t("terms.p3")}</p>
      <p>{t("terms.p4")}</p>
      <p>{t("terms.p5")}</p>
    </div>
    <p class="mt-10 text-caption text-ink-tertiary">{t("terms.updated")}</p>
  </section>
</Layout>
