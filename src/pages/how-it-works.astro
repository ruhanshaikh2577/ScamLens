---
import Layout from "../layouts/Layout.astro";
import CTA from "../components/CTA.astro";

const title = "How ScamLens Works — Scam Checker, Evidence & Privacy | ScamLens";
const description = "Paste a message, link or screenshot: ScamLens redacts sensitive data, runs local pattern checks for urgency, payments, impersonation and link tricks, then shows quoted evidence — never a mystery score.";

const steps = [
  {
    n: "1",
    title: "Pick your input",
    body: "A message, a screenshot of the chat, or a suspicious link — one checker handles all three. Paste text, drop an image, or paste a URL; the checker switches tabs automatically when it recognises what you dropped.",
  },
  {
    n: "2",
    title: "Sensitive data is redacted first",
    body: "Before any analysis, card numbers, Indian mobile numbers and 6-digit OTPs are masked locally. The pattern engine only ever sees the redacted version — even if you accidentally paste an OTP, it never leaves readable form.",
  },
  {
    n: "3",
    title: "Local pattern scan in seconds",
    body: "The engine checks urgency windows, payment demands, OTP asks, bank/courier/government impersonation, UPI handles, prize bait, job fees, legal threats — plus URL signals like shorteners, look-alike domains, punycode, raw IPs and credential-harvesting query strings.",
  },
  {
    n: "4",
    title: "Reasons, not a score",
    body: "Every flag shows the exact quote that triggered it, why it matters, and safe next steps. A Low result means no common markers were found — it is never a guarantee. You stay the judge; we're just the lens.",
  },
];

const redactionDemo = [
  { raw: "OTP is 492813", masked: "OTP is ******", note: "6-digit codes" },
  { raw: "call 9876543210", masked: "call **********", note: "Indian mobiles" },
  { raw: "card 4111 1111 1111 1111", masked: "card **** **** **** ****", note: "16-digit cards" },
];
---

<Layout title={title} description={description} ogType="article">
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <nav class="text-caption text-ink-subtle" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink">Home</a>
      <span class="mx-2">/</span>
      <span class="text-ink-muted">How it works</span>
    </nav>

    <header class="mt-6" data-reveal>
      <p class="eyebrow">How it works</p>
      <h1 class="display-section mt-4">From doubt to decision in four steps</h1>
      <p class="mt-4 max-w-2xl text-body-lg leading-relaxed text-ink-muted">
        ScamLens is decision support, not an antivirus scare. Here is exactly what happens
        between pasting a message and reading the verdict — including what we never see.
      </p>
    </header>

    <ol class="mt-12 space-y-4">
      {steps.map((s, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 70}ms`} class="card card-lift p-6">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-primary/40 bg-primary/10 font-mono text-[13px] text-primary-hover">{s.n}</span>
            <h2 class="card-title">{s.title}</h2>
          </div>
          <p class="mt-3 text-body leading-relaxed text-ink-muted">{s.body}</p>
        </li>
      ))}
    </ol>

    <section data-reveal class="mt-14 rounded-lg border border-hairline bg-surface-1 p-6">
      <h2 class="headline">Redaction, before anything else</h2>
      <p class="mt-3 text-body leading-relaxed text-ink-muted">
        Redaction runs locally in your browser before pattern matching. Examples:
      </p>
      <dl class="mt-4 divide-y divide-hairline">
        {redactionDemo.map((r) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[1fr_auto_1fr] sm:items-center sm:gap-3">
            <dt class="font-mono text-[13px] text-ink-muted">{r.raw}</dt>
            <span class="hidden text-ink-tertiary sm:block" aria-hidden="true">→</span>
            <dd class="font-mono text-[13px] text-primary-hover">{r.masked}<span class="ml-2 font-sans text-caption text-ink-tertiary">({r.note})</span></dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 text-caption leading-relaxed text-ink-tertiary">
        Still avoid pasting secrets — the safest secret is one that was never shared.
      </p>
    </section>

    <section data-reveal class="mt-12">
      <h2 class="headline">What the scan checks</h2>
      <p class="mt-3 text-body leading-relaxed text-ink-muted">
        Message signals (urgency, payment asks, OTP requests, impersonation, prize bait,
        job fees, legal threats, UPI handles) and URL signals (shorteners, brand look-alikes,
        punycode, raw IPs, insecure http, hidden credentials, direct APK downloads).
        The full list lives on
        <a href="/what-we-detect" class="text-primary-hover hover:underline">What we detect</a>,
        and every category is documented in the
        <a href="/scams" class="text-primary-hover hover:underline">Scam Library</a>.
      </p>
    </section>

    <section data-reveal class="mt-12 border-t border-hairline pt-8">
      <h2 class="headline">What ScamLens is not</h2>
      <ul class="mt-4 space-y-2.5 text-body leading-relaxed text-ink-muted">
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span>Not a guarantee — language patterns alone never prove a scam.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span>Not a recovery service — if you lost money, call 1930 immediately.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span>Not connected to any bank, wallet or government agency.</li>
      </ul>
      <div class="mt-8 flex flex-col gap-2 sm:flex-row">
        <a href="/#checker" class="btn btn-primary flex-1">Try the checker</a>
        <a href="/what-we-detect" class="btn btn-secondary flex-1">See what we detect</a>
      </div>
    </section>
  </article>

  <CTA />
</Layout>
