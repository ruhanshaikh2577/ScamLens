---
import Layout from "../layouts/Layout.astro";
import CTA from "../components/CTA.astro";

const VERSION = "0.1.1";
const { lastUpdated } = Astro.props as { lastUpdated?: string | Date };
const displayDate = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })
  : "28 August 2026";

const title = "How ScamLens Works — Scam Checker, Evidence & Privacy | ScamLens";
const description = "Paste a message, link or screenshot: ScamLens redacts sensitive data, runs local pattern checks for urgency, payments, impersonation and link tricks, then shows quoted evidence — never a mystery score.";

const steps = [
  {
    n: "1",
    title: "Pick your input",
    body: "A message, a screenshot of the chat, or a suspicious link — one checker handles all three. Paste text, drop an image, or paste a URL; the checker switches tabs automatically when it recognises what you dropped.",
  },
  {
    n: "2",
    title: "Sensitive data is redacted first",
    body: "Before any analysis, card numbers, Indian mobile numbers and 6-digit OTPs are masked locally. The pattern engine only ever sees the redacted version — even if you accidentally paste an OTP, it never leaves readable form.",
  },
  {
    n: "3",
    title: "Local pattern scan in seconds",
    body: "The engine checks urgency windows, payment demands, OTP asks, bank/courier/government impersonation, UPI handles, prize bait, job fees, legal threats — plus URL signals like shorteners, look-alike domains, punycode, raw IPs and credential-harvesting query strings.",
  },
  {
    n: "4",
    title: "Reasons, not a score",
    body: "Every flag shows the exact quote that triggered it, why it matters, and safe next steps. A Low result means no common markers were found — it is never a guarantee. You stay the judge; we're just the lens.",
  },
];

const redactionDemo = [
  { raw: "OTP is 492813", masked: "OTP is ******", note: "6-digit codes" },
  { raw: "call 9876543210", masked: "call **********", note: "Indian mobiles" },
  { raw: "card 4111 1111 1111 1111", masked: "card **** **** **** ****", note: "16-digit cards" },
];

const detectors = [
  { id: "payment-request", label: "Payment request", purpose: "Amount or fee demanded to receive a parcel, refund, prize or job." },
  { id: "otp-pin", label: "Asks for OTP / PIN / password", purpose: "Any request to share or enter a secret code." },
  { id: "urgency", label: "Artificial urgency", purpose: "Expire/today/24 h windows pressuring instant action." },
  { id: "fear-threat", label: "Fear or legal threat", purpose: "Police, arrest, FIR, court or account-block threats." },
  { id: "impersonation", label: "Impersonates bank / courier / agency", purpose: "Name-drops HDFC/SBI/DTDC/India Post/RBI/TRAI etc." },
  { id: "reward-bait", label: "Prize or reward bait", purpose: "Lottery, lucky draw, prize, cashback you never entered." },
  { id: "job-fee", label: "Too-good job with upfront fee", purpose: "Work-from-home / task-pay with registration fee." },
  { id: "qr-upi", label: "QR / UPI to “receive” money", purpose: "Scan QR or enter PIN to receive funds — always a pay trick." },
  { id: "investment-bait", label: "Guaranteed-return investment", purpose: "Guaranteed/assured profit, double-money, VIP trading groups." },
  { id: "family-emergency", label: "Family member from new number", purpose: "“Hi Mum/Dad — new number” emergency asking for money." },
  { id: "utility-disconnection", label: "Utility disconnection tonight", purpose: "Electricity will be cut tonight unless you pay now." },
  { id: "loan-app", label: "Instant loan with upfront fee", purpose: "Instant approval / 5-minute loan asking for processing fee." },
  { id: "text-shortener", label: "Shortened link in message", purpose: "bit.ly / tinyurl etc. hiding the real destination." },
];

const urlSignals = [
  { id: "url-shortener", label: "Shortened link hides destination", purpose: "bit.ly, tinyurl, t.co and 10+ others." },
  { id: "url-punycode", label: "Look-alike characters (punycode)", purpose: "xn-- domains spoofing brand names." },
  { id: "url-ip", label: "Raw IP instead of domain", purpose: "http://192.168.x.x style links." },
  { id: "url-insecure-http", label: "Insecure http://", purpose: "No encryption for anything typed next." },
  { id: "url-userinfo", label: "“@” trick", purpose: "Real destination hides before the @ in the URL." },
  { id: "url-apk", label: "Direct APK download", purpose: ".apk files that can install SMS-stealing malware." },
  { id: "url-tld", label: "High-abuse domain ending", purpose: ".zip / .top / .xyz / .click etc. heavily abused by kits." },
  { id: "url-credentials", label: "Sensitive fields in the link", purpose: "?password= / ?otp= / ?pin= pre-filled in the URL." },
  { id: "url-brand-mismatch", label: "Brand name on wrong domain", purpose: "Contains hdfcbank/amazon etc. but not the official domain." },
];
---

<Layout title={title} description={description} ogType="article">
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <nav class="text-caption text-ink-subtle" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink">Home</a>
      <span class="mx-2">/</span>
      <span class="text-ink-muted">How it works</span>
    </nav>

    <header class="mt-6" data-reveal>
      <p class="eyebrow">How it works</p>
      <h1 class="display-section mt-4">From doubt to decision in four steps</h1>
      <p class="mt-4 max-w-2xl text-body-lg leading-relaxed text-ink-muted">
        ScamLens is rule-based decision support that identifies signals associated with known patterns — not an antivirus or a guarantee. Here is exactly what happens
        between pasting a message and reading the verdict — including what we never see.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-2 rounded-lg border border-hairline bg-surface-1 px-4 py-3 text-caption leading-relaxed">
        <span class="inline-flex items-center rounded-full border border-hairline-strong bg-surface-2 px-2.5 py-0.5 font-mono text-[11px] tracking-wide text-ink-muted">Analyzer v{VERSION}</span>
        <span class="text-ink-tertiary">Methodology last updated {displayDate}</span>
        <span class="hidden text-ink-tertiary sm:inline">·</span>
        <span class="text-ink-subtle">Static, no data leaves your device for analysis.</span>
      </div>
    </header>

    <ol class="mt-12 space-y-4">
      {steps.map((s, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 70}ms`} class="card card-lift p-6">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-primary/40 bg-primary/10 font-mono text-[13px] text-primary-hover">{s.n}</span>
            <h2 class="card-title">{s.title}</h2>
          </div>
          <p class="mt-3 text-body leading-relaxed text-ink-muted">{s.body}</p>
        </li>
      ))}
    </ol>

    <section data-reveal class="mt-14 rounded-lg border border-hairline bg-surface-1 p-6">
      <h2 class="headline">Redaction, before anything else</h2>
      <p class="mt-3 text-body leading-relaxed text-ink-muted">
        Redaction runs locally in your browser before pattern matching. Examples:
      </p>
      <dl class="mt-4 divide-y divide-hairline">
        {redactionDemo.map((r) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[1fr_auto_1fr] sm:items-center sm:gap-3">
            <dt class="font-mono text-[13px] text-ink-muted">{r.raw}</dt>
            <span class="hidden text-ink-tertiary sm:block" aria-hidden="true">→</span>
            <dd class="font-mono text-[13px] text-primary-hover">{r.masked}<span class="ml-2 font-sans text-caption text-ink-tertiary">({r.note})</span></dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 text-caption leading-relaxed text-ink-tertiary">
        Still avoid pasting secrets — the safest secret is one that was never shared.
      </p>
    </section>

    <section data-reveal class="mt-12" id="detectors">
      <h2 class="headline">What the scan checks — detectors</h2>
      <p class="mt-3 text-body leading-relaxed text-ink-muted">
        ScamLens is rule-based: it identifies signals associated with known patterns in common frauds across India and globally. Each detector looks for a narrow phrase or shape and quotes the exact match as evidence.
      </p>
      <div class="mt-6 overflow-x-auto rounded-lg border border-hairline">
        <table class="w-full min-w-[520px] text-left text-sm">
          <thead class="bg-surface-1 text-caption uppercase tracking-wide text-ink-subtle">
            <tr><th class="px-4 py-3 font-medium">ID</th><th class="px-4 py-3 font-medium">Detector</th><th class="px-4 py-3 font-medium">Purpose</th></tr>
          </thead>
          <tbody class="divide-y divide-hairline text-body-sm leading-relaxed text-ink-muted">
            {detectors.map((d) => (
              <tr class="bg-canvas"><td class="px-4 py-2.5 font-mono text-[12px] text-ink-subtle">{d.id}</td><td class="px-4 py-2.5 text-ink">{d.label}</td><td class="px-4 py-2.5">{d.purpose}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-caption leading-relaxed text-ink-tertiary">
        Every flag links to a Scam Library entry with example messages and verification steps. See <a href="/what-we-detect" class="text-primary-hover hover:underline">What we detect</a>.
      </p>
    </section>

    <section data-reveal class="mt-12" id="url-signals">
      <h2 class="headline">URL signals</h2>
      <p class="mt-3 text-body leading-relaxed text-ink-muted">
        When the input is a link, ScamLens parses the URL separately — without fetching it — and identifies signals associated with known phishing and malware-delivery patterns.
      </p>
      <div class="mt-6 overflow-x-auto rounded-lg border border-hairline">
        <table class="w-full min-w-[520px] text-left text-sm">
          <thead class="bg-surface-1 text-caption uppercase tracking-wide text-ink-subtle">
            <tr><th class="px-4 py-3 font-medium">ID</th><th class="px-4 py-3 font-medium">Signal</th><th class="px-4 py-3 font-medium">Purpose</th></tr>
          </thead>
          <tbody class="divide-y divide-hairline text-body-sm leading-relaxed text-ink-muted">
            {urlSignals.map((u) => (
              <tr class="bg-canvas"><td class="px-4 py-2.5 font-mono text-[12px] text-ink-subtle">{u.id}</td><td class="px-4 py-2.5 text-ink">{u.label}</td><td class="px-4 py-2.5">{u.purpose}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section data-reveal class="mt-12 rounded-lg border border-hairline bg-surface-1 p-6">
      <h2 class="headline">How risk is decided</h2>
      <p class="mt-3 text-body leading-relaxed text-ink-muted">
        Each signal contributes to risk — multiple signals → higher risk. The engine does not expose numeric weights or thresholds (to avoid helping evasion), but the ranking is simple:
      </p>
      <ul class="mt-4 space-y-2 text-body-sm leading-relaxed text-ink-muted">
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span><strong class="text-ink">Low</strong> — no common scam markers found.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span><strong class="text-ink">Medium</strong> — one or two warning signs present.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span><strong class="text-ink">High</strong> — several signals together.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span><strong class="text-ink">Critical</strong> — classic scam pattern with multiple strong signals.</li>
      </ul>
      <p class="mt-4 text-caption leading-relaxed text-ink-tertiary">
        Risk is shown with quoted evidence for each flag so you can verify yourself — never as a mystery score. Exact weights and thresholds are intentionally not published.
      </p>
    </section>

    <section data-reveal class="mt-12 rounded-lg border border-hairline bg-surface-1 p-6" id="limitations">
      <h2 class="headline">Limitations</h2>
      <ul class="mt-4 space-y-2.5 text-body leading-relaxed text-ink-muted">
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span><strong class="text-ink">Rule-based:</strong> identifies signals associated with known patterns — it does not use AI to “know” intent and can miss novel phrasing.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span><strong class="text-ink">False negatives &amp; positives:</strong> clever wording can evade rules; legitimate urgent messages can match a pattern. Always verify via official channels.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span><strong class="text-ink">Low ≠ safe:</strong> a Low result means no common markers were found — it is not a guarantee of safety.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span><strong class="text-ink">Not a recovery service:</strong> if you lost money or shared credentials, call 1930 and your bank immediately — ScamLens cannot recover funds.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span><strong class="text-ink">Not affiliated:</strong> not connected to any bank, wallet, courier or government agency; no endorsement is implied.</li>
      </ul>
    </section>

    <section data-reveal class="mt-12 border-t border-hairline pt-8">
      <h2 class="headline">What ScamLens is not</h2>
      <ul class="mt-4 space-y-2.5 text-body leading-relaxed text-ink-muted">
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span>Not a guarantee — language patterns alone never prove a scam.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span>Not a recovery service — if you lost money, call 1930 immediately.</li>
        <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span>Not connected to any bank, wallet or government agency.</li>
      </ul>
      <div class="mt-8 flex flex-col gap-2 sm:flex-row">
        <a href="/#checker" class="btn btn-primary flex-1">Try the checker</a>
        <a href="/what-we-detect" class="btn btn-secondary flex-1">See what we detect</a>
      </div>
    </section>
  </article>

  <CTA />
</Layout>
