---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  keywords?: string;
  noindex?: boolean;
  showAnchorAd?: boolean;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  keywords = "scam detector, scam checker, fake website checker, phishing link checker, URL scam checker, verify website safety, report a scam",
  noindex = false,
  showAnchorAd = false,
  ogImage = "https://scamlens.in/og.png",
  ogType = "website",
} = Astro.props;
const canonical = `https://scamlens.in${Astro.url.pathname === "/" ? "/" : Astro.url.pathname}`;
const path = Astro.url.pathname;

// Real routes for every nav item — each page stands alone.
const navLinks = [
  { href: "/how-it-works", label: "How it works" },
  { href: "/what-we-detect", label: "What we detect" },
  { href: "/scams", label: "Scam Library" },
  { href: "/safety-tips", label: "Safety tips" },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light") document.documentElement.classList.add("light");
        else if (t === "dark") document.documentElement.classList.add("dark");
      } catch {}
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="ScamLens" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="en-IN" href={canonical} />
    <link rel="alternate" hreflang="en-US" href={canonical} />
    <link rel="alternate" hreflang="en-GB" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="ScamLens" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#010102" />
    <script is:inline>
      try {
        const tm = localStorage.getItem("theme");
        const v = tm === "light" ? "light" : tm === "dark" ? "dark" : "system";
        const sysLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        document.querySelector('meta[name="theme-color"]').content = v === "light" || (v === "system" && sysLight) ? "#ffffff" : "#010102";
      } catch {}
    </script>
    <meta name="application-name" content="ScamLens" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ScamLens" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ScamLens — Not sure if it's a scam? Check before you click." />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@scamlens" />
    <meta name="twitter:creator" content="@scamlens" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="ScamLens — Not sure if it's a scam? Check before you click." />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "ScamLens",
      alternateName: ["Scam Lens", "scamlens", "scam detector", "scam checker"],
      url: "https://scamlens.in",
      description: "Not sure if it's a scam? Check before you click.",
      inLanguage: "en-IN",
      publisher: { "@type": "Organization", name: "ScamLens", url: "https://scamlens.in", logo: { "@type": "ImageObject", url: "https://scamlens.in/og.png" }, sameAs: ["https://cybercrime.gov.in"] },
      potentialAction: { "@type": "SearchAction", target: "https://scamlens.in/scams?q={search_term_string}", "query-input": "required name=search_term_string" }
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface-2 focus:px-3 focus:py-2 focus:text-sm focus:text-ink">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-hairline bg-canvas/85 backdrop-blur">
      <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Main">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-[17px]">
          <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="15" cy="15" r="9.5" fill="none" stroke="#5e6ad2" stroke-width="3"/>
            <line x1="22" y1="22" x2="29" y2="29" stroke="#5e6ad2" stroke-width="3" stroke-linecap="round"/>
          </svg>
          ScamLens
        </a>
        <div class="hidden md:flex items-center gap-7 text-sm text-ink-subtle">
          {navLinks.map((l) => (
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class:list={["nav-link transition-colors", isActive(l.href) ? "text-ink" : "hover:text-ink"]}
            >{l.label}</a>
          ))}
        </div>
        <div class="flex items-center gap-2">
          <button id="theme-toggle" type="button" aria-label="Theme: system" title="Theme: system (click to change)" class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-md border border-hairline bg-surface-1 text-ink-subtle transition-colors hover:border-hairline-strong hover:text-ink active:border-hairline-tertiary active:text-ink">
            <span id="theme-icon" aria-hidden="true"></span>
          </button>
          <a href="https://cybercrime.gov.in" target="_blank" rel="noopener noreferrer" class="btn btn-secondary hidden sm:inline-flex">Report a scam</a>
          <a href="/#checker" class="btn btn-primary">Check now</a>
        </div>
      </nav>
      <nav class="flex gap-2 overflow-x-auto border-t border-hairline px-4 py-2 scrollbar-none md:hidden" aria-label="Sections">
        {navLinks.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
            class:list={["shrink-0 rounded-full border px-3 py-2.5 text-xs font-medium transition-colors min-h-[44px] inline-flex items-center", isActive(l.href) ? "border-hairline-strong bg-surface-2 text-ink" : "border-hairline bg-surface-1 text-ink-subtle hover:text-ink"]}
          >{l.label}</a>
        ))}
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-hairline bg-canvas px-4 pt-16 pb-10 text-caption text-ink-subtle sm:px-6">
      <div class="mx-auto max-w-6xl">
        <div class="grid grid-cols-2 gap-10 md:grid-cols-4">
          <div class="col-span-2 md:col-span-1">
            <div class="flex items-center gap-2 font-semibold text-[15px] text-ink">
              <svg width="16" height="16" viewBox="0 0 32 32" aria-hidden="true">
                <circle cx="15" cy="15" r="9.5" fill="none" stroke="#5e6ad2" stroke-width="3"/>
                <line x1="22" y1="22" x2="29" y2="29" stroke="#5e6ad2" stroke-width="3" stroke-linecap="round"/>
              </svg>
              ScamLens
            </div>
            <p class="mt-3 leading-relaxed">Before you click. Check it.<br />Decision support — never a guarantee.</p>
          </div>
          <div>
            <p class="mb-3 font-medium text-ink-muted">Product</p>
            <ul class="space-y-2">
              <li><a href="/#checker" class="hover:text-ink transition-colors">Scam Checker</a></li>
              <li><a href="/how-it-works" class="hover:text-ink transition-colors">How it works</a></li>
              <li><a href="/what-we-detect" class="hover:text-ink transition-colors">What we detect</a></li>
              <li><a href="/scams" class="hover:text-ink transition-colors">Scam Library</a></li>
              <li><a href="/safety-tips" class="hover:text-ink transition-colors">Safety Tips</a></li>
            </ul>
          </div>
          <div>
            <p class="mb-3 font-medium text-ink-muted">Company</p>
            <ul class="space-y-2">
              <li><a href="/about" class="hover:text-ink transition-colors">About</a></li>
              <li><a href="/privacy" class="hover:text-ink transition-colors">Privacy</a></li>
              <li><a href="/terms" class="hover:text-ink transition-colors">Terms</a></li>
            </ul>
          </div>
          <div>
            <p class="mb-3 font-medium text-ink-muted">Get help</p>
            <ul class="space-y-2">
              <li>India: <a href="https://cybercrime.gov.in" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">cybercrime.gov.in</a> · <a href="tel:1930" class="text-ink-muted hover:text-ink">1930</a></li>
              <li>US: <a href="https://reportfraud.ftc.gov" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">reportfraud.ftc.gov</a> · <a href="https://www.ssa.gov/scam/" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">ssa.gov/scam</a></li>
              <li>UK: <a href="https://www.actionfraud.police.uk" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">actionfraud.police.uk</a> · <a href="https://www.gov.uk/report-suspicious-emails-websites-phishing" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">gov.uk/phishing</a></li>
              <li class="pt-1 text-ink-tertiary">Forward texts to 7726 (SPAM) worldwide.</li>
            </ul>
          </div>
        </div>
        <div class="mt-12 flex flex-col gap-2 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} ScamLens · scamlens.in</p>
          <p>Verify via official channels. In an emergency, call 1930.</p>
        </div>
      </div>
    </footer>

    {showAnchorAd && (
      <aside id="anchor-ad" class="fixed inset-x-0 bottom-0 z-30 border-t border-hairline bg-surface-1/95 backdrop-blur" aria-label="Advertisement">
        <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
          <span class="text-xs uppercase tracking-widest text-ink-tertiary">Advertisement</span>
          <button
            class="rounded-md px-2 py-1 text-caption text-ink-subtle hover:bg-surface-2 hover:text-ink"
            onclick="document.getElementById('anchor-ad').remove()"
          >Close</button>
        </div>
      </aside>
    )}

    <script is:inline>
      (() => {
        // Theme — delegated so it survives client-side navigation (View Transitions).
        const icons = {
          system: '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="8" rx="1.5"/><path d="M6 13h4M8 11v2"/></svg>',
          light: '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 2v1M8 13v1M2 8h1M13 8h1M4.22 4.22l.7.7M11.08 11.08l.7.7M11.78 4.22l-.7.7M4.92 11.08l-.7.7"/></svg>',
          dark: '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M11.8 8A4.2 4.2 0 014.2 11.8 5.2 5.2 0 0011.8 8z"/><path d="M8 3a5.2 5.2 0 00-3.8 8.8A4.2 4.2 0 0111.8 8H8z" opacity="0"/></svg>',
        };
        const order = ["system", "light", "dark"];
        const label = (v) => `Theme: ${v} (click to change)`;
        function current() {
          const h = document.documentElement;
          if (h.classList.contains("light")) return "light";
          if (h.classList.contains("dark")) return "dark";
          return "system";
        }
        function sync() {
          const btn = document.getElementById("theme-toggle");
          const icon = document.getElementById("theme-icon");
          const meta = document.querySelector('meta[name="theme-color"]');
          if (!btn || !icon) return;
          const v = current();
          icon.innerHTML = icons[v];
          btn.setAttribute("aria-label", label(v));
          btn.title = label(v);
          if (meta) {
            const sysLight = window.matchMedia("(prefers-color-scheme: light)").matches;
            meta.content = v === "light" || (v === "system" && sysLight) ? "#ffffff" : "#010102";
          }
        }
        function cycle() {
          const h = document.documentElement;
          const cur = current();
          h.classList.remove("light", "dark");
          const next = order[(order.indexOf(cur) + 1) % 3];
          try {
            if (next === "light") { h.classList.add("light"); localStorage.setItem("theme", "light"); }
            else if (next === "dark") { h.classList.add("dark"); localStorage.setItem("theme", "dark"); }
            else localStorage.removeItem("theme");
          } catch {}
          sync();
        }
        document.addEventListener("click", (e) => {
          const t = e.target;
          if (t instanceof Element && t.closest("#theme-toggle")) cycle();
        });
        document.addEventListener("astro:after-swap", () => {
          sync();
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            const sysLight = window.matchMedia("(prefers-color-scheme: light)").matches;
            meta.content = current() === "light" || (current() === "system" && sysLight) ? "#ffffff" : "#010102";
          }
        });
        window.matchMedia("(prefers-color-scheme: light)").addEventListener?.("change", sync);
        sync();
      })();

      (() => {
        // Scroll reveals — one observer for the whole site, re-initialised on every view transition.
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var io = null;
        if (!reduce && "IntersectionObserver" in window) {
          io = new IntersectionObserver(
            (entries) => {
              for (const en of entries) {
                if (en.isIntersecting) {
                  en.target.classList.add("revealed");
                  io.unobserve(en.target);
                }
              }
            },
            { threshold: 0.1, rootMargin: "0px 0px -36px" }
          );
        }
        function initReveals() {
          document.querySelectorAll("[data-reveal]").forEach((el) => {
            if (el.classList.contains("revealed")) return;
            if (io) io.observe(el);
            else el.classList.add("revealed");
          });
        }
        document.addEventListener("astro:page-load", initReveals);
        initReveals();
      })();
    </script>
  </body>
</html>
