---
const faqs = [
  {
    q: "Does ScamLens store what I paste or upload?",
    a: "No. Your input stays in your browser during the scan and nothing is written to our servers. Screenshots are processed locally and never uploaded in this version.",
  },
  {
    q: "What exactly does the analysis see?",
    a: "Only the text you provide — and even that is first redacted: OTPs, card numbers and phone numbers are masked before any pattern matching happens.",
  },
  {
    q: "Is a Low Risk result a guarantee something is safe?",
    a: "No. We show warning signs we can detect, not certainty. A clean scan means no common scam markers were found — always verify important requests via official channels.",
  },
  {
    q: "Why do you show evidence quotes instead of a score?",
    a: "Because a number like 87/100 tells you nothing. Seeing \u201CPay Rs 99 to reschedule\u201D flagged as a payment request lets you judge the message yourself — which is the skill that protects you next time.",
  },
  {
    q: "Is it free?",
    a: "Yes. The checker is free and shows at most one unobtrusive ad. The scam library keeps the lights on.",
  },
  {
    q: "I already lost money. What now?",
    a: "Call 1930 immediately — the first hour matters most. Then file a complaint at cybercrime.gov.in with screenshots and transaction IDs.",
  },
];

const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});
---

<section id="faq" class="border-t border-hairline px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-2xl">
    <div data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 class="display-section mt-4">Straight answers</h2>
    </div>
    <div data-reveal style="--reveal-delay: 80ms" class="mt-10 divide-y divide-hairline border-y border-hairline">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-body font-medium text-ink [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="shrink-0 text-ink-subtle transition-transform group-open:rotate-45" aria-hidden="true">
              <path d="M8 3v10M3 8h10" />
            </svg>
          </summary>
          <p class="mt-3 pr-8 text-body-sm leading-relaxed text-ink-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script is:inline type="application/ld+json" set:html={ld} />
</section>
