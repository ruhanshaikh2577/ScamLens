---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section id="about-scamlens" class="border-t border-hairline px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-3xl">
    <p class="eyebrow">{t("seoContent.eyebrow")}</p>
    <h2 class="display-section mt-4">{t("seoContent.title")}</h2>
    <p class="mt-4 max-w-2xl text-body leading-relaxed text-ink-muted">
      {t("seoContent.subtitle")}
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={translatePath("/how-it-works")} class="text-sm font-medium text-ink underline decoration-hairline-strong underline-offset-4 hover:text-primary-hover">{t("seoContent.btn.methodology")}</a>
      <a href={translatePath("/what-we-detect")} class="text-sm font-medium text-ink underline decoration-hairline-strong underline-offset-4 hover:text-primary-hover">{t("seoContent.btn.what")}</a>
      <a href={translatePath("/scams")} class="text-sm font-medium text-ink underline decoration-hairline-strong underline-offset-4 hover:text-primary-hover">{t("seoContent.btn.library")}</a>
    </div>

    <details class="group mt-10 rounded-lg border border-hairline bg-surface-1">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-medium text-ink [&::-webkit-details-marker]:hidden">
        <span>{t("seoContent.detailsToggle")}</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="shrink-0 text-ink-subtle transition-transform group-open:rotate-45" aria-hidden="true">
          <path d="M8 3v10M3 8h10" />
        </svg>
      </summary>
      <div class="border-t border-hairline px-5 pb-6 pt-6">
        <h3 class="display-section !text-2xl">{t("seo.home.title")}</h3>
        <div class="prose prose-invert mt-6 max-w-none space-y-6 text-body leading-relaxed text-ink-muted prose-headings:font-semibold prose-headings:text-ink prose-strong:text-ink prose-a:text-ink prose-a:underline">
          <p set:html={t("seoBody.p1")} />
          <p set:html={t("seoBody.p2")} />

          <h3 class="headline mt-10 !text-ink">{t("seoBody.h.how")}</h3>
          <p set:html={t("seoBody.p.how")} />

          <h3 class="headline mt-10 !text-ink">{t("seoBody.h.fake")}</h3>
          <p set:html={t("seoBody.p.fake")} />

          <h3 class="headline mt-10 !text-ink">{t("seoBody.h.phishing")}</h3>
          <p set:html={t("seoBody.p.phishing")} />

          <h3 class="headline mt-10 !text-ink">{t("seoBody.h.image")}</h3>
          <p set:html={t("seoBody.p.image")} />

          <h3 class="headline mt-10 !text-ink">{t("seoBody.h.trust")}</h3>
          <ul class="list-disc space-y-2 pl-6">
            {t("seoBody.trustItems").split("|").map((li) => <li set:html={li.trim()} />)}
          </ul>

          <h3 class="headline mt-10 !text-ink">{t("seoBody.h.howto")}</h3>
          <ol class="list-decimal space-y-2 pl-6">
            {t("seoBody.howtoSteps").split("|").map((s) => <li set:html={s.trim()} />)}
          </ol>
          <p set:html={t("seoBody.p.flow")} />

          <h3 class="headline mt-10 !text-ink">{t("seoBody.h.report")}</h3>
          <p set:html={t("seoBody.p.report")} />

          <p class="text-caption text-ink-tertiary">
            {t("seoBody.footer")}
          </p>
        </div>
      </div>
    </details>
  </div>
</section>
