---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Global scale — FBI IC3 2024, same for all locales (ponytail: one source, no per-language branching)
const stats = [
  {
    value: "860",
    prefix: "",
    suffix: "k+",
    label: t("stats.label.complaints"),
  },
  {
    value: "16.6",
    prefix: "$",
    suffix: "B+",
    label: t("stats.label.losses"),
  },
  {
    value: "9",
    prefix: "",
    suffix: "M+",
    label: t("stats.label.total"),
  },
];
---

<section id="scale" class="border-b border-hairline px-4 py-16 sm:py-20 sm:px-6" aria-label={t("stats.aria")}>
  <div class="mx-auto max-w-6xl">
    <p class="eyebrow" data-reveal>{t("stats.eyebrow")}</p>
    <div class="mt-8 grid gap-10 sm:grid-cols-3 sm:gap-6">
      {stats.map((s, i) => (
        <div
          data-reveal
          style={`--reveal-delay: ${i * 90}ms`}
          class:list={["text-center sm:text-left", i > 0 ? "sm:border-l sm:border-hairline sm:pl-8" : ""]}
        >
          <p class="tabular-nums text-ink" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; line-height: 1.1; letter-spacing: -1px;">
            <span class="text-ink">{s.prefix}</span>{s.value}<span class="text-ink">{s.suffix}</span>
          </p>
          <p class="mx-auto mt-3 max-w-xs text-body-sm leading-relaxed text-ink-muted sm:mx-0">{s.label}</p>
        </div>
      ))}
    </div>
    <p class="mt-10 text-caption leading-relaxed text-ink-tertiary" data-reveal>
      {t("stats.footnote")} — <a href="https://www.ic3.gov/AnnualReport/Reports/2024_IC3Report.pdf" target="_blank" rel="noopener noreferrer" class="text-ink-muted hover:text-ink">FBI IC3 2024</a>. {t("stats.help")} <a href="#footer-help" class="text-ink-muted hover:text-ink">{t("footer.help")}</a>.
    </p>
  </div>
</section>
