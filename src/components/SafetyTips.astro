---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

interface Props {
  /** Show only the first N rules (home page) — full list lives on /safety-tips. */
  limit?: number;
  showPrint?: boolean;
}

const { limit, showPrint = true } = Astro.props;

const rawRules = t("safety.rules").split("|");
const rules = rawRules.map((r) => r.trim()).filter(Boolean);

const shown = typeof limit === "number" ? rules.slice(0, limit) : rules;
const heading = typeof limit === "number" ? t("safety.title.limit", { n: String(limit) }) : t("safety.title.full");
---

<section id="safety-tips" class="border-t border-hairline px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p class="eyebrow">{t("safety.eyebrow")}</p>
        <h2 class="display-section mt-4">{heading}</h2>
      </div>
      {showPrint && <button onclick="window.print()" class="btn btn-secondary">{t("safety.print")}</button>}
    </div>

    <ol id="safety-rules" class="mt-12 grid gap-x-10 gap-y-0 lg:grid-cols-2 print:grid-cols-1">
      {shown.map((r, i) => (
        <li
          data-reveal
          style={`--reveal-delay: ${Math.min(i, 6) * 60}ms`}
          class="flex gap-4 border-b border-hairline py-4 last:border-b-0 lg:[&:nth-last-child(2)]:border-b-0"
        >
          <span class="mt-0.5 font-mono text-[13px] text-ink-muted">{String(i + 1).padStart(2, "0")}</span>
          <p class="text-body leading-relaxed text-ink-muted">{r}</p>
        </li>
      ))}
    </ol>

    {typeof limit === "number" && (
      <div data-reveal class="mt-8">
        <a href={translatePath("/safety-tips")} class="text-sm font-medium text-ink underline decoration-hairline-strong underline-offset-4 hover:text-primary-hover">{t("safety.all", { n: String(rules.length) })}</a>
      </div>
    )}

    <p class="mt-8 text-caption text-ink-tertiary" data-reveal>{t("safety.shareNote")}</p>
  </div>

  <style>
    @media print {
      header, footer, #checker, .eyebrow { display: none !important; }
      body { background: white !important; color: black !important; }
      section#safety-tips { border: none !important; padding: 0 !important; }
      li p { color: black !important; }
      button[onclick] { display: none !important; }
    }
  </style>
</section>
