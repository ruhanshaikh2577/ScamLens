---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import { getCollection } from "astro:content";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const folderMap = {es:"estafas", fr:"arnaques", de:"betrugsmaschen", "pt-br":"golpes", it:"truffe", ja:"scams", ko:"scams"};
// New global slugs exist in EN only until translated — fall back to the EN page.
const availableSlugs = new Set((await getCollection("scams")).map((s) => s.id));
const localizedHref = (slug: string) => lang !== "en" && availableSlugs.has(`${lang}/${slug}`) ? `/${lang}/${folderMap[lang as keyof typeof folderMap] || "scams"}/${slug}` : `/scams/${slug}`;

interface Props {
  /** Extended variant adds the newer pattern cards + signal checklist (used on /what-we-detect). */
  extended?: boolean;
}

const { extended = false } = Astro.props;

const cards = [
  {
    title: t("what.card.whatsapp.title"),
    body: t("what.card.whatsapp.body"),
    icon: "M8 2h8a6 6 0 016 6v5a6 6 0 01-6 6H9l-5 3v-3.5A6 6 0 012 13V8a6 6 0 016-6z",
    href: localizedHref("bank-otp-impersonation"),
  },
  {
    title: t("what.card.websites.title"),
    body: t("what.card.websites.body"),
    icon: "M10 14a5 5 0 007.07 0l3-3a5 5 0 00-7.07-7.07L11.5 5.4 M14 10a5 5 0 00-7.07 0l-3 3A5 5 0 0011 19.6l1.5-1.47",
    href: localizedHref("parcel-delivery-fee"),
  },
  {
    title: t("what.card.screenshots.title"),
    body: t("what.card.screenshots.body"),
    icon: "M4 4h16v12H4z M8 20h8 M12 16v4",
    href: localizedHref("qr-payment-scam"),
  },
  {
    title: t("what.card.upi.title"),
    body: t("what.card.upi.body"),
    icon: "M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h2v2h-2z M18 18h2v2h-2z M14 18h2 M18 14h2",
    href: localizedHref("toll-road-sms"),
  },
  {
    title: t("what.card.jobs.title"),
    body: t("what.card.jobs.body"),
    icon: "M4 8h16v12H4z M9 8V6a3 3 0 016 0v2",
    href: localizedHref("job-task-scam"),
  },
  {
    title: t("what.card.indian.title"),
    body: t("what.card.indian.body"),
    icon: "M12 3l9 16H3l9-16z M12 10v4 M12 16.5v.5",
    href: localizedHref("tech-support-refund"),
  },
];

const extendedCards = [
  {
    title: t("what.card.investment.title"),
    body: t("what.card.investment.body"),
    icon: "M3 20h18 M6 16l4-6 4 3 5-8",
    href: localizedHref("trading-app-guaranteed-returns"),
  },
  {
    title: t("what.card.family.title"),
    body: t("what.card.family.body"),
    icon: "M12 21s-7-4.35-9.33-8.11C.9 9.75 2.58 6 6 6c1.9 0 3.13 1 4 2.09C10.87 7 12.1 6 14 6c3.42 0 5.1 3.75 3.33 6.89C15 16.65 12 21 12 21z",
    href: localizedHref("family-emergency-message"),
  },
  {
    title: t("what.card.loan.title"),
    body: t("what.card.loan.body"),
    icon: "M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z",
    href: localizedHref("advance-fee-loan"),
  },
];

const shown = extended ? [...cards, ...extendedCards] : cards;

const messageSignals = t("what.messageSignals.list").split("|");
const urlSignals = t("what.urlSignals.list").split("|");
---

<section id="what-we-detect" class="border-t border-hairline px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div data-reveal>
      <p class="eyebrow">{t("what.eyebrow")}</p>
      <h2 class="display-section mt-4 max-w-xl">{t("what.title")}</h2>
      {extended && (
        <p class="mt-4 max-w-2xl text-body-lg leading-relaxed text-ink-muted">
          {t("what.extended.subtitle")}
        </p>
      )}
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {shown.map((c, i) => (
        <a
          href={c.href}
          data-reveal
          style={`--reveal-delay: ${(i % 3) * 80}ms`}
          class="card group p-6"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink-muted" aria-hidden="true">
            <path d={c.icon} />
          </svg>
          <h3 class="card-title mt-4">{c.title}</h3>
          <p class="mt-2 text-body-sm leading-relaxed text-ink-muted">{c.body}</p>
        </a>
      ))}
    </div>

    {!extended && (
      <div data-reveal class="mt-10 text-center">
        <a href={translatePath("/what-we-detect")} class="text-sm font-medium text-ink underline decoration-hairline-strong underline-offset-4 hover:text-primary-hover">{t("what.cta.all")}</a>
      </div>
    )}

    {extended && (
      <div class="mt-16 grid gap-4 md:grid-cols-2">
        <div data-reveal class="card p-6">
          <h3 class="card-title">{t("what.messageSignals.title")}</h3>
          <ul class="mt-4 space-y-2.5 text-body-sm leading-relaxed text-ink-muted">
            {messageSignals.map((s) => (
              <li class="flex gap-2.5">
                <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span>{s}
              </li>
            ))}
          </ul>
        </div>
        <div data-reveal style="--reveal-delay: 90ms" class="card p-6">
          <h3 class="card-title">{t("what.urlSignals.title")}</h3>
          <ul class="mt-4 space-y-2.5 text-body-sm leading-relaxed text-ink-muted">
            {urlSignals.map((s) => (
              <li class="flex gap-2.5">
                <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-hover" aria-hidden="true"></span>{s}
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </div>
</section>
