---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getCollection } from "astro:content";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Same locale-aware library links as WhatWeDetect: localized page when it
// exists, EN fallback otherwise.
const folderMap = {es:"estafas", fr:"arnaques", de:"betrugsmaschen", "pt-br":"golpes", it:"truffe", ja:"scams", ko:"scams"};
const availableSlugs = new Set((await getCollection("scams")).map((s) => s.id));
const localizedHref = (slug: string) => lang !== "en" && availableSlugs.has(`${lang}/${slug}`) ? `/${lang}/${folderMap[lang as keyof typeof folderMap] || "scams"}/${slug}` : `/scams/${slug}`;

const findings = [
  {
    label: t("example.finding.1.label"),
    evidence: t("example.finding.1.evidence"),
  },
  {
    label: t("example.finding.2.label"),
    evidence: t("example.finding.2.evidence"),
  },
  {
    label: t("example.finding.3.label"),
    evidence: t("example.finding.3.evidence"),
  },
  {
    label: t("example.finding.4.label"),
    evidence: t("example.finding.4.evidence"),
  },
];

const steps = [
  t("example.step.1"),
  t("example.step.2"),
  t("example.step.3"),
];
---

<section id="example" class="border-t border-hairline px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="max-w-xl">
      <p class="eyebrow">{t("example.eyebrow")}</p>
      <h2 class="display-section mt-4">{t("example.title")}</h2>
      <p class="mt-4 text-body-lg leading-relaxed text-ink-muted">
        {t("example.subtitle")}
      </p>
    </div>

    <div data-reveal style="--reveal-delay: 100ms" class="card panel-top-edge mx-auto mt-12 w-full max-w-2xl p-5 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="risk-badge risk-high"><span class="risk-dot"></span>{t("checker.result.risk.high")}</span>
        <span class="rounded-md border border-hairline bg-canvas px-2 py-1 font-mono text-xs text-ink-subtle">{t("example.inputLabel")}</span>
      </div>
      <h3 class="card-title mt-4">{t("example.cardTitle")}</h3>
      <blockquote data-sample-text class="mt-4 rounded-lg border border-hairline bg-canvas p-4 font-mono text-[13px] leading-relaxed text-ink-muted">
        Courier: Your parcel ON HOLD [TRK-88213]. Pay a $1.99 redelivery fee today,
        else it will be returned to the depot within 24 hours. bit.ly/post-redeliver
      </blockquote>

      <section class="mt-6" aria-label={t("checker.result.why")}>
        <h4 class="eyebrow">{t("checker.result.why")}</h4>
        <ul class="mt-3 space-y-4">
          {findings.map((f) => (
            <li class="flex gap-3">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-1 shrink-0 text-gold" aria-hidden="true">
                <path d="M8 1l7 13H1L8 1z" stroke="currentColor" stroke-width="1.3" />
                <path d="M8 6v3.5M8 11.6v.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
              </svg>
              <div class="min-w-0">
                <p class="text-sm font-medium text-ink">{f.label}</p>
                <code class="evidence-pill mt-1.5">{f.evidence}</code>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-6 border-t border-hairline pt-6" aria-label={t("checker.result.next")}>
        <h4 class="eyebrow">{t("checker.result.next")}</h4>
        <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-ink-muted">
          {steps.map((s) => <li>{s}</li>)}
        </ol>
      </section>

      <section class="mt-6 border-t border-hairline pt-6" aria-label={t("checker.result.similar")}>
        <h4 class="eyebrow">{t("checker.result.similar")}</h4>
        <div class="mt-3 flex flex-wrap gap-2">
          <a href={localizedHref("parcel-delivery-fee")} class="rounded-full border border-hairline bg-canvas px-3 py-1.5 text-[13px] text-ink-muted transition-colors hover:border-hairline-tertiary hover:text-ink">{t("example.similar.1")}</a>
          <a href={localizedHref("toll-road-sms")} class="rounded-full border border-hairline bg-canvas px-3 py-1.5 text-[13px] text-ink-muted transition-colors hover:border-hairline-tertiary hover:text-ink">{t("example.similar.2")}</a>
        </div>
      </section>

      <p class="mt-4 text-caption leading-relaxed text-ink-tertiary">
        {t("checker.result.disclaimer")}
      </p>
    </div>

    <div class="mx-auto mt-8 w-fit">
      <a href="#checker" data-sample-scan class="btn btn-primary">{t("example.cta")}</a>
    </div>
  </div>
</section>

<script>
  // One-tap sample scan: hand the worked example to the checker via
  // sessionStorage (mount path) + event (already-mounted path).
  document.querySelector("[data-sample-scan]")?.addEventListener("click", () => {
    const sample = document.querySelector("[data-sample-text]")?.textContent?.trim() ?? "";
    if (!sample) return;
    try { sessionStorage.setItem("scamlens:sample", sample); } catch {}
    window.dispatchEvent(new CustomEvent("scamlens:sample", { detail: sample }));
  });
</script>
