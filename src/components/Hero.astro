---
import CheckerIsland from "./checker/CheckerIsland";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative overflow-hidden px-4 pb-20 pt-16 sm:px-6 sm:pt-24">
  <div class="aurora" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl text-center">
    <p class="eyebrow hero-in" style="--hero-delay: 0ms">{t("hero.eyebrow")}</p>
    <h1 class="display-hero mx-auto mt-5 max-w-3xl hero-in" style="--hero-delay: 90ms">
      {t("hero.title.1")}<br />
      <span class="text-ink-subtle">{t("hero.title.2")}</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-body-lg leading-relaxed text-ink-muted hero-in" style="--hero-delay: 180ms">
      {t("hero.subtitle")}
    </p>
  </div>
  <div class="hero-in mt-10" style="--hero-delay: 280ms">
    <CheckerIsland client:visible lang={lang} />
  </div>
  <p class="seal-badge hero-in mx-auto mt-6 w-fit" style="--hero-delay: 360ms"><span class="seal-ring" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 5.2 4 7.4 8.2 2.8"/></svg></span>{t("hero.trust")}</p>
</section>
