---
import CheckerIsland from "./checker/CheckerIsland";
---

<section class="relative px-4 pb-20 pt-16 sm:px-6 sm:pt-24">
  <div class="aurora" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl text-center">
    <p class="eyebrow hero-in" style="--hero-delay: 0ms">ScamLens — Scam intelligence · India-first</p>
    <h1 class="display-hero mx-auto mt-5 max-w-3xl hero-in" style="--hero-delay: 90ms">
      Not sure if it's a scam?<br />
      <span class="text-ink-subtle">Check before you click.</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-body-lg leading-relaxed text-ink-muted hero-in" style="--hero-delay: 180ms">
      Free <strong>AI scam detector</strong> and <strong>scam checker</strong> to verify website safety. Paste a message, screenshot or link — get fake website, phishing URL and scam image detection with evidence quotes.
    </p>
  </div>
  <div class="hero-in mt-10" style="--hero-delay: 280ms">
    <CheckerIsland client:load />
  </div>
</section>
