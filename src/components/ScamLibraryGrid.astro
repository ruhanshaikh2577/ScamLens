---
import { getCollection } from "astro:content";

interface Props {
  /** Show only the first N entries (home page) — the full library lives on /scams. */
  limit?: number;
  /** Hide the section heading when the host page already has one (/scams). */
  heading?: boolean;
}

const { limit, heading = true } = Astro.props;
const all = (await getCollection("scams")).sort((a, b) => a.data.title.localeCompare(b.data.title));
const scams = typeof limit === "number" ? all.slice(0, limit) : all;
---

<section id="scam-library" class="border-t border-hairline px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
      {heading && (
        <div class="max-w-xl">
          <p class="eyebrow">Scam library</p>
          <h2 class="display-section mt-4">Know the pattern before it reaches you</h2>
        </div>
      )}
      <label class:list={["relative w-full max-w-xs", heading ? "" : "sm:ml-auto"]}>
        <span class="sr-only">Search the scam library</span>
        <input
          id="library-search"
          type="search"
          placeholder="Search scams… e.g. UPI, courier, job"
          class="w-full rounded-md border border-hairline bg-surface-1 px-3 py-2 text-sm text-ink placeholder:text-ink-tertiary focus:border-hairline-strong focus:outline-none"
        />
      </label>
    </div>

    <div id="library-grid" class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {scams.map((s, i) => (
        <a
          href={`/scams/${s.id}`}
          data-reveal
          style={`--reveal-delay: ${(i % 3) * 80}ms`}
          data-title={`${s.data.title} ${s.data.intro} ${s.data.tag}`.toLowerCase()}
          class="card card-lift library-card group flex flex-col p-6"
        >
          <span class="status-badge w-fit rounded-full bg-surface-2 px-2 py-0.5 text-xs text-ink-muted">{s.data.tag}</span>
          <h3 class="card-title mt-4">{s.data.title}</h3>
          <p class="mt-2 line-clamp-3 flex-1 text-body-sm leading-relaxed text-ink-muted">{s.data.intro}</p>
          <span class="mt-4 text-[13px] font-medium text-primary-hover">Read the breakdown <span class="arrow-nudge">→</span></span>
        </a>
      ))}
    </div>

    <p id="library-empty" class="mt-10 hidden text-center text-body-sm text-ink-subtle">
      No matches yet — we're adding new patterns every week.
    </p>

    {typeof limit === "number" && (
      <div data-reveal class="mt-10 text-center">
        <a href="/scams" class="btn btn-secondary">Browse all {all.length} breakdowns →</a>
      </div>
    )}
  </div>
</section>

<script>
  function bindLibrarySearch() {
    const input = document.getElementById("library-search") as HTMLInputElement | null;
    const grid = document.getElementById("library-grid");
    const empty = document.getElementById("library-empty");
    if (!input || !grid || !empty || input.dataset.bound) return;
    input.dataset.bound = "1";
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".library-card"));
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const show = !q || (card.dataset.title?.includes(q) ?? false);
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      }
      empty.classList.toggle("hidden", visible > 0);
    });
    // Honour the /scams?q=… contract promised by the WebSite SearchAction schema.
    const q = new URLSearchParams(location.search).get("q");
    if (q) {
      input.value = q;
      input.dispatchEvent(new Event("input"));
    }
  }
  document.addEventListener("astro:page-load", bindLibrarySearch);
  bindLibrarySearch();
</script>
